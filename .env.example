# ── Filo dağıtımı (docker-compose.prod.yml — saha kurulumları) ───────────────
# Watchtower bu image'ın :stable etiketini izler; yeni sürüm geldiğinde çeker.
GHCR_IMAGE=ghcr.io/firatbadur/sais_web
# Hangi sürüm çalışsın: normalde "stable" (otomatik güncellenir).
# Rollback / dondurma için belirli bir sürüme sabitle: IMAGE_TAG=v1.1.0
IMAGE_TAG=stable
# Watchtower kaç saniyede bir GHCR'ı kontrol etsin (default 300 = 5 dk)
WATCHTOWER_POLL_INTERVAL=300
# Dışarı açılan web portu (saha tarafında)
WEB_PORT=8000
# Windows'ta docker config yolu farklıysa override: ör. C:/Users/<user>/.docker
# DOCKER_CONFIG_DIR=~/.docker

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1
# Fleet-wide wildcard ÖNERİLİR: leading-dot tüm subdomain'leri kapsar
# (.envisoft.com.tr → sais-tesis1/2/3... hepsi). Böylece panelden domain
# değişince Django restart gerekmez. Lokal/127.0.0.1'i de bırakın.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.envisoft.com.tr
# CSRF için scheme'li glob (Django 4+): https://*.envisoft.com.tr
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1,https://*.envisoft.com.tr

# Web erişim / Caddy reverse proxy
# Caddy 80/443 dinler, web:8000'e proxy yapar. Domain + SSL dashboard'dan
# (Yönetici → Web Erişim Ayarları) yönetilir; bu yollar caddy_config volume'üne
# göre ayarlıdır, normalde override gerekmez.
CADDY_CONFIG_PATH=/etc/caddy/Caddyfile
CADDY_CERT_DIR=/etc/caddy/certs
CADDY_UPSTREAM=web:8000
DJANGO_LANGUAGE_CODE=en
DJANGO_TIME_ZONE=Europe/Istanbul
DJANGO_USE_TZ=1
DJANGO_LOG_LEVEL=INFO

# PostgreSQL (açık kaynak, lisanssız). Bundled container (docker-compose `db`)
# veya harici bir PostgreSQL sunucusu kullanılabilir.
POSTGRES_DB=envisoft
POSTGRES_USER=envisoft
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

DB_CONN_MAX_AGE=60

# Redis cache
REDIS_URL=redis://localhost:6379/1

# Celery (Redis broker farklı DB; result backend django-db / django-cache / redis://...)
CELERY_BROKER_URL=redis://localhost:6379/2
CELERY_RESULT_BACKEND=django-db

# API request logging
API_LOG_ENABLED=1
API_LOG_RETENTION_DAYS=90
API_LOG_MAX_BODY_CHARS=10000
API_LOG_SKIP_PATHS=/static/,/media/,/__debug__/,/admin/jsi18n/,/favicon.ico
# Allowlist: yalnız bu prefix'lere gelen istekler loglanır (sadece API'yi tut,
# dashboard sayfa/AJAX iç trafiğini loglama). Boş bırakılırsa her şey loglanır.
API_LOG_INCLUDE_PATHS=/GetServerDatetime,/GetData,/GetInstantData,/GetLastDataDate,/GetChannelInformation,/GetStationInformation,/GetCalibration,/GetPowerOffTimes,/GetLog,/StartSample,/api/

# Reading historian retention (prune_readings komutu kullanır)
# 1000 tag × 60sn save ≈ 1.4M satır/gün; 90 gün = 126M satır
READING_RETENTION_RAW_DAYS=90
READING_RETENTION_15M_DAYS=365
READING_RETENTION_HOURLY_DAYS=1825
READING_RETENTION_DAILY_DAYS=99999

# PC kapanma tespiti (heartbeat) — açılışta son canlılık damgası ile şimdiki
# zaman arasındaki boşluk bu dakikayı aşarsa istasyon başına PowerOff kaydı
# düşülür. Kısa container restart'larını kayıt dışı bırakacak kadar büyük tut.
POWEROFF_DETECT_THRESHOLD_MIN=5

# DB yedekleme — .dump dosyalarının (pg_dump -Fc) yazılacağı dizin. app +
# celery_worker container'larına mount edilen pg_backups volume yolu. Tier'ların
# açık/kapalı durumu ve saklama adetleri DB'de (BackupPolicy) tutulur; dashboard
# Yönetici → Yedekleme sayfasından yönetilir.
BACKUP_DIR=/backups

# Lisanslama — kurulum süreli lisansla çalışır; bitince app hiçbir iş yapmaz
# (polling/SIM/Envisoft durur, dashboard kilitlenir). İmzalı (Ed25519) token
# LICENSE_URL manifest'inden çekilir, gömülü public key ile doğrulanır.
# DEV'de DJANGO_DEBUG=1 iken zorlama varsayılan KAPALI (lokal kilitlenmez).
LICENSE_ENFORCE=0
# Bu sahanın benzersiz kimliği (manifest'teki anahtarla eşleşir).
LICENSE_KEY=
# İmzalı lisans manifest'inin URL'i (örn. GitHub raw).
LICENSE_URL=
# İssuer public key (hex). Boş bırakılırsa settings'teki gömülü default kullanılır.
LICENSE_PUBLIC_KEY=
# Bitişe bu kadar gün kala dashboard'da sarı uyarı.
LICENSE_WARN_DAYS=15
# Yeni kurulum, geçerli lisans uygulanana dek EN FAZLA bu kadar saat çalışır
# (deneme/aktivasyon penceresi). Varsayılan 168 = 1 hafta.
LICENSE_BOOTSTRAP_GRACE_HOURS=168
# Makine parmak izi (node-lock) — host (installer/sais-stack.ps1) doldurur; lisans
# token'ı `machine` içeriyorsa bununla eşleşmeli. Dev'de boş bırak.
MACHINE_FINGERPRINT=

# Session
SESSION_COOKIE_AGE=36000

# Production flags (DEBUG=0 iken aktif olanlar)
SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_SSL_REDIRECT=0

# Bakanlık SAIS entegrasyonu (sais_domain.clients.SaisSimClient)
# Üretimde override edilmesi gerekli olmayabilir; default base URL bakanlığın
# resmi entegrasyon adresidir.
SAIS_SIM_BASE_URL=https://entegrationsais.csb.gov.tr
# Bakanlığa SendData payload'unda gönderilen yazılım versiyonu etiketi
SAIS_SIM_SOFTWARE_VERSION=EnvisoftV.2
# Login ticket'ının cache'te tutulma süresi (sn). 401 alındığında nasılsa
# yeniden login olunur; bu sadece reaktif refresh'i geciktirir.
SAIS_SIM_TICKET_TTL=3600
# Eksik veri yeniden gönderim job'ı (her 6 saatte bir GetMissingDates → SendData).
# Tek run'da en fazla kaç eksik dakikanın yeniden gönderileceği (kalan sonraki run'da).
SAIS_MISSING_RESEND_MAX_MINUTES=720
# Eksik dakika için sensörün son (held) değerini ararken geriye bakılan dakika.
SAIS_MISSING_BACKFILL_LOOKBACK_MIN=10

# Envisoft entegrasyonu (sais_domain.clients.EnvisoftClient)
ENVISOFT_DIAGNOSTIC_URL=https://scada.onlinecevre.com.tr/sais-get-diagnostic/
ENVISOFT_SEND_DATA_URL=https://entegration.onlinecevre.com.tr/SendData
ENVISOFT_USERNAME=envisoft
ENVISOFT_PASSWORD=change-me
# Self-signed sertifika için 0 (default); valid sertifika alındığında 1 yapın.
ENVISOFT_VERIFY_TLS=0
