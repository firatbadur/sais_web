# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1
DJANGO_LANGUAGE_CODE=tr
DJANGO_TIME_ZONE=Europe/Istanbul
DJANGO_USE_TZ=0
DJANGO_LOG_LEVEL=INFO

# PostgreSQL
POSTGRES_DB=envisoft
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DB_CONN_MAX_AGE=60

# Alternatif: tek URL ile konfigürasyon (önceliği vardır)
# DATABASE_URL=postgres://postgres:pass@localhost:5432/envisoft

# Redis cache
REDIS_URL=redis://localhost:6379/1

# Session
SESSION_COOKIE_AGE=36000

# Production flags (DEBUG=0 iken aktif olanlar)
SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_SSL_REDIRECT=0
