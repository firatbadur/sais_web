# ── Filo dağıtımı (docker-compose.prod.yml — saha kurulumları) ───────────────
# Watchtower bu image'ın :stable etiketini izler; yeni sürüm geldiğinde çeker.
GHCR_IMAGE=ghcr.io/firatbadur/sais_web
# Hangi sürüm çalışsın: normalde "stable" (otomatik güncellenir).
# Rollback / dondurma için belirli bir sürüme sabitle: IMAGE_TAG=v1.1.0
IMAGE_TAG=stable
# Watchtower kaç saniyede bir GHCR'ı kontrol etsin (default 300 = 5 dk)
WATCHTOWER_POLL_INTERVAL=300
# Dışarı açılan web portu (saha tarafında)
WEB_PORT=8000
# Windows'ta docker config yolu farklıysa override: ör. C:/Users/<user>/.docker
# DOCKER_CONFIG_DIR=~/.docker

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1
# Fleet-wide wildcard ÖNERİLİR: leading-dot tüm subdomain'leri kapsar
# (.envisoft.com.tr → sais-tesis1/2/3... hepsi). Böylece panelden domain
# değişince Django restart gerekmez. Lokal/127.0.0.1'i de bırakın.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.envisoft.com.tr
# CSRF için scheme'li glob (Django 4+): https://*.envisoft.com.tr
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1,https://*.envisoft.com.tr

# Web erişim / Caddy reverse proxy
# Caddy 80/443 dinler, web:8000'e proxy yapar. Domain + SSL dashboard'dan
# (Yönetici → Web Erişim Ayarları) yönetilir; bu yollar caddy_config volume'üne
# göre ayarlıdır, normalde override gerekmez.
CADDY_CONFIG_PATH=/etc/caddy/Caddyfile
CADDY_CERT_DIR=/etc/caddy/certs
CADDY_UPSTREAM=web:8000

# Seri köprü (Windows host COM -> TCP aynası)
# Boş = redirect kapalı (dev / Linux: seri port doğrudan açılır).
# Windows sahada sais-stack.ps1 SERIAL_BRIDGE_HOST'u otomatik yazar (WSL gateway IP).
SERIAL_BRIDGE_HOST=
SERIAL_BRIDGE_PORT_BASE=8900
SERIAL_BRIDGE_DIR=/bridge
# Host'taki paylaşılan köprü dizini (web container'a /bridge olarak mount edilir).
# Windows installer: /mnt/c/EnvisoftWebX/bridge ; dev/Linux: boş bırak (./bridge_shared).
SERIAL_BRIDGE_HOST_DIR=
DJANGO_LANGUAGE_CODE=en
DJANGO_TIME_ZONE=Europe/Istanbul
DJANGO_USE_TZ=1
DJANGO_LOG_LEVEL=INFO

# PostgreSQL (açık kaynak, lisanssız). Bundled container (docker-compose `db`)
# veya harici bir PostgreSQL sunucusu kullanılabilir.
POSTGRES_DB=envisoft
POSTGRES_USER=envisoft
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

DB_CONN_MAX_AGE=60

# Redis cache
REDIS_URL=redis://localhost:6379/1

# Celery (Redis broker farklı DB; result backend django-db / django-cache / redis://...)
CELERY_BROKER_URL=redis://localhost:6379/2
CELERY_RESULT_BACKEND=django-db

# API request logging
API_LOG_ENABLED=1
API_LOG_RETENTION_DAYS=90
API_LOG_MAX_BODY_CHARS=10000
API_LOG_SKIP_PATHS=/static/,/media/,/__debug__/,/admin/jsi18n/,/favicon.ico
# Allowlist: yalnız bu prefix'lere gelen istekler loglanır (sadece API'yi tut,
# dashboard sayfa/AJAX iç trafiğini loglama). Boş bırakılırsa her şey loglanır.
API_LOG_INCLUDE_PATHS=/GetServerDatetime,/GetData,/GetInstantData,/GetLastDataDate,/GetChannelInformation,/GetStationInformation,/GetCalibration,/GetPowerOffTimes,/GetLog,/StartSample,/api/

# Reading historian retention (prune_readings komutu kullanır)
# 1000 tag × 60sn save ≈ 1.4M satır/gün; 90 gün = 126M satır
READING_RETENTION_RAW_DAYS=90
READING_RETENTION_15M_DAYS=365
READING_RETENTION_HOURLY_DAYS=1825
READING_RETENTION_DAILY_DAYS=99999

# İletişim hata teşhisi (CommErrorEvent) — poll_connection okuma hatalarını
# kategorize edip biriktirir (teşhis; polling davranışını değiştirmez).
# MIN_INTERVAL_SEC: aynı sensör+kategori için tabloyu şişirmemek üzere cooldown.
COMM_ERROR_MIN_INTERVAL_SEC=300
COMM_ERROR_RETENTION_DAYS=30

# Persistent connection pool — havuzdaki soket bu kadar sn kullanılmadıysa
# kullanmadan önce tazelenir (kapat+aç). PLC'ler boşta kalan Modbus TCP
# oturumunu kapatır; ölü sokete yazmak BrokenPipeError üretir ve o cycle'ın
# tüm sensörleri bad olur. PLC daha erken düşürüyorsa bu değeri azalt. 0 = kapalı.
POOL_MAX_IDLE_SEC=60

# PC kapanma tespiti (heartbeat) — açılışta son canlılık damgası ile şimdiki
# zaman arasındaki boşluk bu dakikayı aşarsa istasyon başına PowerOff kaydı
# düşülür. Kısa container restart'larını kayıt dışı bırakacak kadar büyük tut.
POWEROFF_DETECT_THRESHOLD_MIN=5

# DB yedekleme — .dump dosyalarının (pg_dump -Fc) yazılacağı dizin. app +
# celery_worker container'larına mount edilen pg_backups volume yolu. Tier'ların
# açık/kapalı durumu ve saklama adetleri DB'de (BackupPolicy) tutulur; dashboard
# Yönetici → Yedekleme sayfasından yönetilir.
BACKUP_DIR=/backups

# Rapor Stüdyosu — üretilen PDF/Excel rapor dosyalarının dizini. Docker'da
# web + celery_worker'a mount edilen report_files volume yolu; dev'de boş
# bırakılırsa media/reports altına düşer. Retention: kayıt + dosyalar bu kadar
# gün saklanır, sonrası gecelik prune_generated_reports ile silinir.
REPORTS_DIR=/reports
REPORT_RETENTION_DAYS=90

# Lisanslama — kurulum süreli lisansla çalışır; bitince app hiçbir iş yapmaz
# (polling/SIM/Envisoft durur, dashboard kilitlenir). İmzalı (Ed25519) token
# LICENSE_URL manifest'inden çekilir, gömülü public key ile doğrulanır.
# NOT: Üretimde (DJANGO_DEBUG=0) enforce KOD ile HER ZAMAN açıktır; bu satır
# ÜRETİMDE YOK SAYILIR (True or X == True) — .env'den lisans kapatılamaz. Yalnız
# dev'de (DJANGO_DEBUG=1) etkilidir: enforce'u test etmek için 1 yapabilirsiniz.
LICENSE_ENFORCE=0
# Bu sahanın benzersiz kimliği (manifest'teki anahtarla eşleşir).
LICENSE_KEY=
# İmzalı lisans manifest'inin URL'i (örn. GitHub raw).
LICENSE_URL=
# İssuer public key (hex). Boş bırakılırsa settings'teki gömülü default kullanılır.
LICENSE_PUBLIC_KEY=
# Bitişe bu kadar gün kala dashboard'da sarı uyarı.
LICENSE_WARN_DAYS=15
# Yeni kurulum, geçerli lisans uygulanana dek EN FAZLA bu kadar saat çalışır
# (deneme/aktivasyon penceresi). Varsayılan 168 = 1 hafta.
LICENSE_BOOTSTRAP_GRACE_HOURS=168
# Makine parmak izi (node-lock) — host (installer/sais-stack.ps1) doldurur; lisans
# token'ı `machine` içeriyorsa bununla eşleşmeli. Dev'de boş bırak.
MACHINE_FINGERPRINT=

# Session
SESSION_COOKIE_AGE=36000

# Production flags (DEBUG=0 iken aktif olanlar)
SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_SSL_REDIRECT=0

# Bakanlık SAIS entegrasyonu (sais_domain.clients.SaisSimClient)
# Üretimde override edilmesi gerekli olmayabilir; default base URL bakanlığın
# resmi entegrasyon adresidir.
SAIS_SIM_BASE_URL=https://entegrationsais.csb.gov.tr
# Bakanlığa SendData payload'unda gönderilen yazılım versiyonu etiketi
SAIS_SIM_SOFTWARE_VERSION=EnvisoftV.2
# Login ticket'ının cache'te tutulma süresi (sn). 401 alındığında nasılsa
# yeniden login olunur; bu sadece reaktif refresh'i geciktirir.
SAIS_SIM_TICKET_TTL=3600

# --- SIM HTTP transport (timeout + retry) ---
# Bakanlik servisi saha kosullarinda sik sik yavasliyor/yanitsiz kaliyor.
# Eskiden timeout sabit 50 sn idi ve HIC retry yoktu (yalniz 401 -> re-login).
SAIS_SIM_CONNECT_TIMEOUT=10
SAIS_SIM_TIMEOUT=120
SAIS_SIM_HTTP_RETRIES=3
# DIKKAT: okuma (read) tekrari transport'ta 0 OLMALI. 120 sn timeout x 4 deneme
# tek istegi ~494 sn'ye cikarir ve CELERY_TASK_TIME_LIMIT=300'u asar (worker
# SIGKILL + ACKS_LATE yeniden teslim = mukerrer gonderim). Okuma timeout'unun
# tekrari KUYRUK seviyesinde yapilir (next_attempt_at backoff'u).
SAIS_SIM_HTTP_READ_RETRIES=0
# urllib3 backoff factor -> 2/4/8 sn bekleyerek tekrar dener
SAIS_SIM_HTTP_BACKOFF=2.0
SAIS_SIM_HTTP_BACKOFF_MAX=30
SAIS_SIM_RETRY_STATUSES=429,500,502,503,504
# Agir sorgu uclari (GetMissingDates / GetDataByBetweenTwoDate) 180 sn timeout
# kullanir; orada 3 retry ~12 dk surerdi -> ayri, dusuk retry.
SAIS_SIM_LONG_QUERY_RETRIES=1

# --- SIM gonderim kuyrugu (store-and-forward outbox) ---
# Dakikalik SendData payload'lari once kuyruga yazilir; drenaj task'i kabin
# bazinda SIKI FIFO ile bosaltir: bastaki kayit Bakanlik tarafindan kabul
# edilene kadar sonraki dakikalar GONDERILMEZ.
SAIS_SIM_OUTBOX_ENABLED=1
# Kalici ret (HTTP 4xx / result=false) bu kadar denemeden sonra failed olur ve
# kuyruk ilerler (tek bozuk dakika sahayi sonsuza dek kilitlemesin).
SAIS_SIM_OUTBOX_MAX_ATTEMPTS=10
# Bekleyen kayitlarin son kullanma suresi. NOT: bu yalnizca ILK VARSAYILANDIR;
# calisma zamaninda deger SystemSwitch.sim_accept_window_hours'tan okunur ve
# dashboard > Sistem Kontrol sayfasindan degistirilir (Bakanlik normalde son
# 48 saati kabul eder ama bakim vb. durumlarda pencereyi uzatabiliyor).
SAIS_SIM_OUTBOX_MAX_AGE_HOURS=48
# Bir drenaj turunun duvar-saati butcesi (sn) + kayit tavani.
# Butce yalnizca YENI gonderim baslatmayi durdurur; suren istek kesilmez.
SAIS_SIM_OUTBOX_DRAIN_BUDGET_SEC=60
SAIS_SIM_OUTBOX_DRAIN_MAX=60
# Kuyruk seviyesi backoff: min(BASE * 2**(deneme-1), MAX) saniye (+-%10 jitter).
SAIS_SIM_OUTBOX_BACKOFF_BASE_SEC=30
SAIS_SIM_OUTBOX_BACKOFF_MAX_SEC=600
# Kalici ret icin backoff tavani (ret zaten sinirli sayida denenecek).
SAIS_SIM_OUTBOX_REJECT_BACKOFF_MAX_SEC=60
# Drenaj kilidi TTL'i (worker cokerse kendiliginden dussun) + `sending`
# durumunda takili kalan kaydin kuyruga geri alinma suresi.
SAIS_SIM_OUTBOX_LOCK_TTL_SEC=280
SAIS_SIM_OUTBOX_CLAIM_LEASE_SEC=300
# Sistematik ret: pes pese bu kadar kayit ayni nedenle reddedilirse sonraki
# retler ilk denemede failed olur (kuyruk saatlerce tikanmasin).
SAIS_SIM_OUTBOX_POISON_STREAK=3
# Bakanlik "bu dakika zaten var" derse KABUL sayilir (mukerrer gonderim
# kuyrugu zehirlemesin). Saha yanit metni gozlemlendikce genisletin.
SAIS_SIM_DUPLICATE_KEYWORDS=tekrar veri,zaten mevcut,zaten var,already exists,duplicate
# SIM iletimi kapaliyken de kuyruga yazilsin mi? (varsayilan evet - aksi halde
# "10 dakikaligina kapatayim" denen surede gecen dakikalar kalici kaybolur)
SAIS_SIM_OUTBOX_ENQUEUE_WHEN_DISABLED=1
# publish_cabinet_data mesaj omru: readtime planlanan dakikaya sabitlendigi
# icin GEC calisan task eski dakikaya taze snapshot yazardi -> bayat mesaj duser.
SAIS_PUBLISH_TASK_EXPIRES_SEC=45
# Ayni kabin icin eszamanli login'leri serilestir (ticket cache yarisi).
SAIS_SIM_LOGIN_LOCK_SEC=30
# Gonderilmis/suresi gecmis kuyruk kayitlarinin saklama suresi (gun).
# failed kayitlar SILINMEZ (operator gorsun).
SIM_OUTBOX_RETENTION_DAYS=7
# Iletilemeyen (reddedilen/suresi dolan/atlanan) kayitlar - teshis icin daha uzun.
SIM_OUTBOX_DEAD_RETENTION_DAYS=30
# Eksik veri yeniden gönderim job'ı (her 6 saatte bir GetMissingDates → SendData).
# Tek run'da en fazla kaç eksik dakikanın yeniden gönderileceği (kalan sonraki run'da).
SAIS_MISSING_RESEND_MAX_MINUTES=720
# Eksik dakika için sensörün son (held) değerini ararken geriye bakılan dakika.
SAIS_MISSING_BACKFILL_LOOKBACK_MIN=10

# Envisoft entegrasyonu (sais_domain.clients.EnvisoftClient)
ENVISOFT_DIAGNOSTIC_URL=https://scada.onlinecevre.com.tr/sais-get-diagnostic/
ENVISOFT_SEND_DATA_URL=https://entegration.onlinecevre.com.tr/SendData
ENVISOFT_USERNAME=envisoft
ENVISOFT_PASSWORD=change-me
# Self-signed sertifika için 0 (default); valid sertifika alındığında 1 yapın.
ENVISOFT_VERIFY_TLS=0

# Kabin sırları (SaisCabinet.auth_secret) at-rest Fernet şifreleme anahtarı — DB +
# pg_dump yedeklerinde Bakanlık şifresi düz metin durmasın diye. Boş bırakılırsa
# SECRET_KEY'den türetilir (bkz. sais_domain/crypto.py). Kalıcı kurulumda açıkça
# üretip SABİT tutun (üret: python -c "from cryptography.fernet import Fernet;
# print(Fernet.generate_key().decode())"). SECRET_KEY döndürülürse türetilen anahtar
# değişir → eski şifreli değerler okunamaz.
CABINET_FERNET_KEY=
