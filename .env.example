# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1
DJANGO_LANGUAGE_CODE=tr
DJANGO_TIME_ZONE=Europe/Istanbul
DJANGO_USE_TZ=0
DJANGO_LOG_LEVEL=INFO

# Microsoft SQL Server
MSSQL_DB=envisoft
MSSQL_USER=sa
MSSQL_PASSWORD=change-me
MSSQL_HOST=localhost
MSSQL_PORT=1433
# Mevcut sistemde kurulu olan driver adı (pyodbc.drivers() ile listeleyebilirsin)
MSSQL_DRIVER=ODBC Driver 17 for SQL Server
# Kendi kendine imzalı sertifika için TrustServerCertificate=yes
MSSQL_TRUST_SERVER_CERTIFICATE=1
# Windows Integrated Auth kullanıyorsan MSSQL_USER/PASSWORD'ü boş bırak ve şunu aktif et:
MSSQL_TRUSTED_CONNECTION=0

DB_CONN_MAX_AGE=60

# Redis cache
REDIS_URL=redis://localhost:6379/1

# Session
SESSION_COOKIE_AGE=36000

# Production flags (DEBUG=0 iken aktif olanlar)
SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_SSL_REDIRECT=0
